<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: deploy/install-updater.sh fills in the paths. Checks GitHub every 5 minutes. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.livingtown.updater</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/living-town/deploy/auto-update.js</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/living-town</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LIVING_TOWN_BRANCH</key><string>claude/code-review-4vrxjs</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/living-town-updater.log</string>
  <key>StandardErrorPath</key><string>/tmp/living-town-updater.log</string>
</dict>
</plist>
