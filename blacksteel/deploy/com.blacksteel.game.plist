<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace the three ALL-CAPS placeholders before installing. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blacksteel.game</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/blacksteel</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOST</key><string>MOUSE_TAILSCALE_IP</string>
    <key>PORT</key><string>4320</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/blacksteel.log</string>
  <key>StandardErrorPath</key><string>/tmp/blacksteel.log</string>
</dict>
</plist>
